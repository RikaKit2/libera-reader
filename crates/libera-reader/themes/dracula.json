{
  "$schema": "https://github.com/longbridge/gpui-component/raw/refs/heads/main/.theme-schema.json",
  "name": "Dracula",
  "author": "DaisyUI",
  "themes": [
    {
      "name": "Dracula",
      "mode": "dark",
      "colors": {
        "background": "#282a36",
        "foreground": "#f8f8f2",
        "border": "#44475a",
        "primary.background": "#ff79c6",
        "primary.foreground": "#282a36",
        "secondary.background": "#bd93f9",
        "secondary.foreground": "#282a36",
        "accent.background": "#ffb86c",
        "accent.foreground": "#282a36",
        "panel.background": "#21222c",
        "popover.background": "#191a21",
        "danger.background": "#ff5555",
        "base.red": "#ff5555",
        "base.green": "#50fa7b",
        "base.blue": "#8be9fd",
        "base.yellow": "#f1fa8c"
      },
      "highlight": {
        "editor.background": "#282a36",
        "editor.foreground": "#f8f8f2",
        "syntax": {
          "keyword": { "color": "#ff79c6" },
          "function": { "color": "#bd93f9" },
          "string": { "color": "#50fa7b" },
          "comment": { "color": "#6272a4" }
        }
      }
    }
  ]
}