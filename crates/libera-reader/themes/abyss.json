{
  "$schema": "https://github.com/longbridge/gpui-component/raw/refs/heads/main/.theme-schema.json",
  "name": "Abyss",
  "author": "DaisyUI",
  "themes": [
    {
      "name": "Abyss",
      "mode": "dark",
      "colors": {
        "background": "#1a2332",
        "foreground": "#b4c6ef",
        "border": "#0f141d",
        "primary.background": "#5ed46a",
        "primary.foreground": "#1a2332",
        "secondary.background": "#c297ef",
        "secondary.foreground": "#1a2332",
        "accent.background": "#6b7280",
        "accent.foreground": "#ffffff",
        "panel.background": "#141b26",
        "popover.background": "#0d1117",
        "danger.background": "#f87171",
        "base.red": "#f87171",
        "base.green": "#4ade80",
        "base.blue": "#60a5fa",
        "base.yellow": "#fbbf24"
      },
      "highlight": {
        "editor.background": "#1a2332",
        "editor.foreground": "#b4c6ef",
        "syntax": {
          "keyword": { "color": "#5ed46a" },
          "function": { "color": "#c297ef" },
          "string": { "color": "#4ade80" },
          "comment": { "color": "#4b5563" }
        }
